# Required by the direct Go Minecraft client.
MINECRAFT_HOST=192.168.31.170
MINECRAFT_PORT=64735
MINECRAFT_USERNAME=king_crimson_bot

# Optional structured logs. Packet receive/send records require debug.
MINECRAFT_LOG_LEVEL=debug
MINECRAFT_LOG_FORMAT=text

# Legacy Mineflayer/Redis playground settings. The Go client does not read these.
REDIS_URL=redis://localhost:6379/0
BOT_ID=king_crimson
MINECRAFT_AUTH=offline
MINECRAFT_VERSION=1.21.11

# Optional prepared-world telemetry demo. The worker remains passive unless enabled.
BOT_DEMO_ENABLED=false
BOT_DEMO_CENTER_X=0
BOT_DEMO_CENTER_Y=64
BOT_DEMO_CENTER_Z=0
BOT_DEMO_RADIUS=4
BOT_DEMO_CHEST_X=0
BOT_DEMO_CHEST_Y=64
BOT_DEMO_CHEST_Z=0
BOT_DEMO_WATER_X=0
BOT_DEMO_WATER_Y=64
BOT_DEMO_WATER_Z=0
BOT_DEMO_EFFECT_X=0
BOT_DEMO_EFFECT_Y=64
BOT_DEMO_EFFECT_Z=0
BOT_DEMO_ITEM_NAME=stone
