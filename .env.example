# Required by the direct Go Minecraft client.
MINECRAFT_HOST=192.168.31.170
MINECRAFT_PORT=64735
MINECRAFT_USERNAME=king_crimson_bot

# Optional structured logs. Packet receive/send records require debug.
MINECRAFT_LOG_LEVEL=debug
MINECRAFT_LOG_FORMAT=text

# Legacy Mineflayer/Redis playground settings. The Go client does not read these.
REDIS_URL=redis://localhost:6379/0
BOT_ID=king_crimson
MINECRAFT_AUTH=offline
MINECRAFT_VERSION=1.21.11
